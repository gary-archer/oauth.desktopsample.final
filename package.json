{
  "name": "finaldesktopapp",
  "version": "2.0.0",
  "description": "The Final OpenID Connect secured Desktop App",
  "author": "Gary Archer",
  "license": "MIT",
  "main": "main.bundle.js",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "build": {
    "protocols": {
      "name": "finaldesktopapp",
      "schemes": [
        "x-authsamples-desktopapp"
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "start": "./start.sh",
    "package": "./package.sh"
  },
  "dependencies": {
    "@openid/appauth": "^1.3.2",
    "electron-store": "^12.0.0",
    "js-event-bus": "^1.1.1",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-modal": "^3.16.3",
    "react-router": "^8.5.1",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-modal": "^3.16.3",
    "electron": "^45.2.1",
    "eslint": "^10.14.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "workspaces": [
    "build",
    "tools"
  ]
}
